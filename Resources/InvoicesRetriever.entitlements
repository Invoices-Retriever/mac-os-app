<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- §8.3: distribution is outside the Mac App Store. The App Store sandbox
         cannot host a driven browser with per-source persistent profiles, and
         pretending otherwise would mean shipping something that does not work.
         The hardened runtime is on; JIT is required by JavaScriptCore, which
         WebKit needs to render a modern portal at all. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- No keychain-access-group is declared. The default group is the
         application's own, which is what we want: nothing else should reach
         these items. Declaring one would also require a provisioning profile
         that grants it, and an unexpanded $(AppIdentifierPrefix) — an Xcode
         build variable, meaningless to a SwiftPM build — makes the signature
         invalid and the app refuses to launch. -->
</dict>
</plist>
