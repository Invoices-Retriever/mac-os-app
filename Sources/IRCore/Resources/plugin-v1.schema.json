{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invoices-retriever.github.io/schema/plugin-v1.json",
  "title": "Invoices Retriever plugin manifest, version 1",
  "description": "Declarative description of how to authenticate to a supplier portal and list its invoices. A plugin is data, never code: the only escape hatch is the runJs step, which is flagged and requires human review (see CONTRIBUTING).",
  "type": "object",
  "required": ["id", "name", "version", "engine", "allowedDomains", "checkAuth", "getDocuments"],
  "additionalProperties": false,

  "properties": {
    "$schema": { "type": "string" },

    "id": {
      "type": "string",
      "description": "Unique, stable, lowercase identifier. Never change it once published: sources reference it.",
      "pattern": "^[a-z0-9][a-z0-9-]{1,48}[a-z0-9]$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": {
      "type": "string",
      "description": "Semantic version of this plugin. Bump on every merged change.",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-.]+)?$"
    },
    "description": { "type": "string", "maxLength": 400 },
    "homepage": { "type": "string", "format": "uri", "pattern": "^https://" },
    "maintainers": {
      "type": "array",
      "items": { "type": "string", "pattern": "^@[A-Za-z0-9-]+$" },
      "description": "GitHub handles. An empty list means unmaintained; see the archival policy."
    },
    "country": {
      "type": "array",
      "description": "ISO 3166-1 alpha-2 codes, or EU. Drives catalogue browsing by market.",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^([A-Z]{2}|EU)$" }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "maxItems": 12
    },
    "engine": {
      "type": "string",
      "description": "Minimum engine version required, as a caret or >= range. The app refuses a plugin demanding more than it implements.",
      "pattern": "^(>=|\\^|~)?(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },

    "allowedDomains": {
      "type": "array",
      "description": "MANDATORY network sandbox. The driver — not the plugin — blocks every navigation and subresource outside this list. This is the single most important security control in the project.",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "string",
        "pattern": "^(\\*\\.)?([a-z0-9]([a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,}$"
      }
    },

    "usesJs": {
      "type": "boolean",
      "default": false,
      "description": "Declares that this plugin contains runJs steps. The UI surfaces it and CI cross-checks the declaration against the actual steps."
    },

    "status": {
      "enum": ["unverified", "active", "degraded", "archived"],
      "default": "active",
      "description": "unverified is where every plugin starts: structurally valid, never run against a live account. active once someone has. degraded when it is failing for several people, archived when unmaintained and broken for 90 days — archived plugins are no longer offered for installation."
    },

    "configSchema": {
      "type": "object",
      "description": "Fields the app asks the user for. Keys become {{config.<key>}}; password and totp values become {{secret.<key>}} and never leave the vault.",
      "additionalProperties": { "$ref": "#/$defs/configField" }
    },

    "autofill": {
      "description": "true to fill credentials automatically where the plugin says to, false to always let the user type them, or a per-field object.",
      "oneOf": [
        { "type": "boolean" },
        {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        }
      ],
      "default": true
    },

    "checkAuth": {
      "$ref": "#/$defs/steps",
      "description": "Determines whether the persisted session is still valid. Must end in a verification step (checkURL or checkElementExists)."
    },
    "startAuth": {
      "$ref": "#/$defs/steps",
      "description": "Interactive login. Runs with the browser visible. Omit to rely purely on the user logging in by hand."
    },
    "getConfigOptions": {
      "$ref": "#/$defs/steps",
      "description": "Optional discovery pass exposing choices (sub-accounts, contracts) through exposeOption."
    },
    "getDocuments": {
      "$ref": "#/$defs/steps",
      "description": "Lists and downloads invoices. Every document must be emitted by a document-producing step."
    }
  },

  "$defs": {
    "configField": {
      "type": "object",
      "required": ["type", "label"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["string", "password", "totp", "number", "boolean", "select", "date"] },
        "label": { "type": "string", "minLength": 1 },
        "help": { "type": "string" },
        "required": { "type": "boolean", "default": false },
        "default": {},
        "placeholder": { "type": "string" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value", "label"],
            "properties": { "value": { "type": "string" }, "label": { "type": "string" } },
            "additionalProperties": false
          }
        }
      }
    },

    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 120,
      "items": { "$ref": "#/$defs/step" }
    },

    "selector": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "CSS selector. Prefix with 'text=' to match by visible text, or 'xpath=' for XPath."
    },

    "document": {
      "type": "object",
      "description": "Normalised document descriptor. id and date are mandatory; total is strongly recommended.",
      "required": ["id", "date"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable per-source document identifier. Used for deduplication with (source, id)."
        },
        "date": {
          "type": "string",
          "description": "ISO 8601 date, or a template resolving to one. Common non-ISO formats are parsed leniently."
        },
        "total": {
          "type": "string",
          "description": "Gross amount. Accepts '1 234,56 €', '$1,234.56', '1234.56'."
        },
        "currency": {
          "type": "string",
          "description": "ISO 4217 code. Inferred from total when omitted."
        },
        "net": { "type": "string" },
        "vat": { "type": "string" },
        "number": { "type": "string", "description": "Invoice number as printed on the document." },
        "issuer": { "type": "string" },
        "type": {
          "enum": ["invoice", "credit-note", "receipt", "statement", "other"],
          "default": "invoice"
        },
        "metadata": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },

    "step": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": { "type": "string" },
        "description": {
          "type": "string",
          "description": "Shown in the run log and the step-by-step debugger."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "navigate" } }, "required": ["action"] },
          "then": {
            "required": ["url"],
            "properties": {
              "action": {},
              "description": {},
              "url": {
                "type": "string",
                "description": "Must be https. A value built from a template is checked at run time instead, because the host cannot be known statically.",
                "anyOf": [{ "pattern": "^https://" }, { "pattern": "\\{\\{" }]
              }
            },
            "additionalProperties": false
          }
        },

        {
          "if": { "properties": { "action": { "const": "waitForURL" } }, "required": ["action"] },
          "then": {
            "required": ["url"],
            "properties": {
              "action": {},
              "description": {},
              "url": {
                "type": "string",
                "description": "Glob-ish pattern; * matches any run of characters."
              },
              "timeout": { "$ref": "#/$defs/timeout" }
            },
            "additionalProperties": false
          }
        },

        {
          "if": {
            "properties": { "action": { "const": "waitForElement" } },
            "required": ["action"]
          },
          "then": {
            "required": ["selector"],
            "properties": {
              "action": {},
              "description": {},
              "selector": { "$ref": "#/$defs/selector" },
              "timeout": { "$ref": "#/$defs/timeout" }
            },
            "additionalProperties": false
          }
        },

        {
          "if": {
            "properties": { "action": { "const": "waitForNavigation" } },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "action": {},
              "description": {},
              "timeout": { "$ref": "#/$defs/timeout" }
            },
            "additionalProperties": false
          }
        },

        {
          "if": {
            "properties": { "action": { "const": "waitForNetworkIdle" } },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "action": {},
              "description": {},
              "idleMs": { "type": "integer", "minimum": 100, "maximum": 10000, "default": 500 },
              "timeout": { "$ref": "#/$defs/timeout" }
            },
            "additionalProperties": false
          }
        },

        {
          "if": { "properties": { "action": { "const": "click" } }, "required": ["action"] },
          "then": {
            "required": ["selector"],
            "properties": {
              "action": {},
              "description": {},
              "selector": { "$ref": "#/$defs/selector" },
              "optional": {
                "type": "boolean",
                "default": false,
                "description": "Do not fail if the element is absent."
              },
              "timeout": { "$ref": "#/$defs/timeout" }
            },
            "additionalProperties": false
          }
        },

        {
          "if": { "properties": { "action": { "const": "type" } }, "required": ["action"] },
          "then": {
            "required": ["selector", "value"],
            "properties": {
              "action": {},
              "description": {},
              "selector": { "$ref": "#/$defs/selector" },
              "value": {
                "type": "string",
                "description": "Template. Use {{secret.<key>}} for vault values, {{totp.<key>}} for a generated code."
              },
              "pressEnter": { "type": "boolean", "default": false },
              "timeout": { "$ref": "#/$defs/timeout" }
            },
            "additionalProperties": false
          }
        },

        {
          "if": {
            "properties": { "action": { "const": "dropdownSelect" } },
            "required": ["action"]
          },
          "then": {
            "required": ["selector", "value"],
            "properties": {
              "action": {},
              "description": {},
              "selector": { "$ref": "#/$defs/selector" },
              "value": { "type": "string" },
              "timeout": { "$ref": "#/$defs/timeout" }
            },
            "additionalProperties": false
          }
        },

        {
          "if": { "properties": { "action": { "const": "runJs" } }, "required": ["action"] },
          "then": {
            "required": ["code"],
            "properties": {
              "action": {},
              "description": {},
              "code": {
                "type": "string",
                "maxLength": 4000,
                "description": "Evaluated in the page. Requires usesJs: true and human review."
              },
              "assignTo": { "$ref": "#/$defs/varName" },
              "timeout": { "$ref": "#/$defs/timeout" }
            },
            "additionalProperties": false
          }
        },

        {
          "if": {
            "properties": { "action": { "const": "checkElementExists" } },
            "required": ["action"]
          },
          "then": {
            "required": ["selector"],
            "properties": {
              "action": {},
              "description": {},
              "selector": { "$ref": "#/$defs/selector" },
              "expect": { "type": "boolean", "default": true },
              "timeout": { "$ref": "#/$defs/timeout" }
            },
            "additionalProperties": false
          }
        },

        {
          "if": { "properties": { "action": { "const": "checkURL" } }, "required": ["action"] },
          "then": {
            "required": ["url"],
            "properties": {
              "action": {},
              "description": {},
              "url": { "type": "string" },
              "expect": { "type": "boolean", "default": true }
            },
            "additionalProperties": false
          }
        },

        {
          "if": { "properties": { "action": { "const": "extract" } }, "required": ["action"] },
          "then": {
            "required": ["assignTo"],
            "properties": {
              "action": {},
              "description": {},
              "selector": { "$ref": "#/$defs/selector" },
              "attribute": {
                "type": "string",
                "description": "Read this attribute instead of the text content. 'href' and 'src' are resolved to absolute URLs."
              },
              "regex": {
                "type": "string",
                "description": "Applied to the extracted value; capture group 1 wins if present."
              },
              "from": { "enum": ["element", "url", "title", "page"], "default": "element" },
              "assignTo": { "$ref": "#/$defs/varName" },
              "optional": { "type": "boolean", "default": false },
              "timeout": { "$ref": "#/$defs/timeout" }
            },
            "additionalProperties": false
          }
        },

        {
          "if": { "properties": { "action": { "const": "extractAll" } }, "required": ["action"] },
          "then": {
            "required": ["selector", "forEach"],
            "properties": {
              "action": {},
              "description": {},
              "selector": { "$ref": "#/$defs/selector" },
              "fields": {
                "type": "object",
                "description": "Per-row extraction, relative to the matched element. Values become {{item.<key>}} inside forEach.",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "selector": { "$ref": "#/$defs/selector" },
                    "attribute": { "type": "string" },
                    "regex": { "type": "string" },
                    "optional": { "type": "boolean", "default": false }
                  }
                }
              },
              "limit": { "type": "integer", "minimum": 1, "maximum": 500 },
              "forEach": { "$ref": "#/$defs/steps" }
            },
            "additionalProperties": false
          }
        },

        {
          "if": {
            "properties": { "action": { "const": "extractNetworkResponse" } },
            "required": ["action"]
          },
          "then": {
            "required": ["url", "assignTo"],
            "properties": {
              "action": {},
              "description": {},
              "url": {
                "type": "string",
                "description": "Pattern matched against request URLs observed since the previous step."
              },
              "jsonPath": {
                "type": "string",
                "description": "Dotted path into the JSON body, e.g. data.invoices"
              },
              "assignTo": { "$ref": "#/$defs/varName" },
              "timeout": { "$ref": "#/$defs/timeout" }
            },
            "additionalProperties": false
          }
        },

        {
          "if": { "properties": { "action": { "const": "downloadPdf" } }, "required": ["action"] },
          "then": {
            "required": ["url", "document"],
            "properties": {
              "action": {},
              "description": {},
              "url": { "type": "string" },
              "document": { "$ref": "#/$defs/document" },
              "timeout": { "$ref": "#/$defs/timeout" }
            },
            "additionalProperties": false
          }
        },

        {
          "if": {
            "properties": { "action": { "const": "waitForPdfDownload" } },
            "required": ["action"]
          },
          "then": {
            "required": ["document"],
            "properties": {
              "action": {},
              "description": {},
              "document": { "$ref": "#/$defs/document" },
              "timeout": { "$ref": "#/$defs/timeout" }
            },
            "additionalProperties": false
          }
        },

        {
          "if": { "properties": { "action": { "const": "printPdf" } }, "required": ["action"] },
          "then": {
            "required": ["document"],
            "properties": {
              "action": {},
              "description": {},
              "document": { "$ref": "#/$defs/document" },
              "selector": { "$ref": "#/$defs/selector" },
              "timeout": { "$ref": "#/$defs/timeout" }
            },
            "additionalProperties": false
          }
        },

        {
          "if": {
            "properties": { "action": { "const": "downloadBase64Pdf" } },
            "required": ["action"]
          },
          "then": {
            "required": ["data", "document"],
            "properties": {
              "action": {},
              "description": {},
              "data": {
                "type": "string",
                "description": "Template resolving to base64 payload, with or without a data: prefix."
              },
              "document": { "$ref": "#/$defs/document" }
            },
            "additionalProperties": false
          }
        },

        {
          "if": { "properties": { "action": { "const": "if" } }, "required": ["action"] },
          "then": {
            "required": ["condition", "then"],
            "properties": {
              "action": {},
              "description": {},
              "condition": { "$ref": "#/$defs/condition" },
              "then": { "$ref": "#/$defs/steps" },
              "else": { "$ref": "#/$defs/steps" }
            },
            "additionalProperties": false
          }
        },

        {
          "if": { "properties": { "action": { "const": "sleep" } }, "required": ["action"] },
          "then": {
            "required": ["ms"],
            "properties": {
              "action": {},
              "description": {},
              "ms": {
                "type": "integer",
                "minimum": 1,
                "maximum": 30000,
                "description": "Capped at 30 s. Rate limiting is enforced by the engine regardless."
              }
            },
            "additionalProperties": false
          }
        },

        {
          "if": { "properties": { "action": { "const": "exposeOption" } }, "required": ["action"] },
          "then": {
            "required": ["key", "label"],
            "properties": {
              "action": {},
              "description": {},
              "key": { "$ref": "#/$defs/varName" },
              "label": { "type": "string" },
              "values": {
                "type": "string",
                "description": "Template resolving to a variable holding a list of {value,label} objects."
              },
              "multiple": { "type": "boolean", "default": false }
            },
            "additionalProperties": false
          }
        },

        {
          "properties": {
            "action": {
              "enum": [
                "navigate",
                "waitForURL",
                "waitForElement",
                "waitForNavigation",
                "waitForNetworkIdle",
                "click",
                "type",
                "dropdownSelect",
                "runJs",
                "checkElementExists",
                "checkURL",
                "extract",
                "extractAll",
                "extractNetworkResponse",
                "downloadPdf",
                "waitForPdfDownload",
                "printPdf",
                "downloadBase64Pdf",
                "if",
                "sleep",
                "exposeOption"
              ]
            }
          }
        }
      ]
    },

    "condition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "elementExists": { "$ref": "#/$defs/selector" },
        "urlMatches": { "type": "string" },
        "variableEquals": {
          "type": "object",
          "required": ["name", "value"],
          "additionalProperties": false,
          "properties": { "name": { "type": "string" }, "value": { "type": "string" } }
        },
        "variableIsSet": { "type": "string" },
        "not": { "$ref": "#/$defs/condition" }
      },
      "minProperties": 1,
      "maxProperties": 1
    },

    "varName": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,40}$" },

    "timeout": {
      "type": "integer",
      "minimum": 100,
      "maximum": 120000,
      "description": "Milliseconds. The engine also enforces a global per-run budget."
    }
  }
}
